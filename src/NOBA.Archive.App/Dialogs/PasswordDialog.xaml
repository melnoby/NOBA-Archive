<ContentDialog
    x:Class="NOBA.Archive.App.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    Background="{ThemeResource NobaSurfaceRaised}"
    BorderBrush="{ThemeResource NobaBorderSubtle}">

    <StackPanel Spacing="12" MinWidth="380">

        <!-- A retry is stated before anything else. The second attempt is the one that needs a reason. -->
        <InfoBar
            x:Name="RetryBar"
            IsOpen="False"
            IsClosable="False"
            Severity="Error" />

        <TextBlock
            x:Name="BodyText"
            TextWrapping="Wrap"
            Foreground="{ThemeResource NobaTextPrimary}" />

        <!--
            The archive and entry lines are the evidence the person judges before typing a secret.
            NobaMonoTextStyle pins them left to right; the view model has already isolated them, so
            neither this panel's direction nor the string's own content can reorder what they read.
        -->
        <TextBlock
            x:Name="ArchiveText"
            Style="{StaticResource NobaMonoTextStyle}"
            TextWrapping="Wrap"
            IsTextSelectionEnabled="True" />

        <TextBlock
            x:Name="EntryText"
            Style="{StaticResource NobaMonoTextStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            IsTextSelectionEnabled="True" />

        <StackPanel Spacing="6">
            <TextBlock
                x:Name="FieldLabel"
                FontSize="{StaticResource NobaTypeCaptionSize}"
                Foreground="{ThemeResource NobaTextSecondary}" />

            <!--
                PasswordRevealMode is Hidden, not Peek: the secret is never on screen unless the person
                asks for it with the checkbox below, which is a deliberate act rather than a hover.
            -->
            <PasswordBox
                x:Name="PasswordField"
                PasswordRevealMode="Hidden"
                FlowDirection="LeftToRight" />

            <CheckBox
                x:Name="RevealBox"
                Checked="OnRevealChanged"
                Unchecked="OnRevealChanged" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
