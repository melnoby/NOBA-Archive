<ContentDialog
    x:Class="NOBA.Archive.App.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    Background="{ThemeResource NobaSurfaceRaised}"
    BorderBrush="{ThemeResource NobaBorderSubtle}">

    <!--
        DefaultButton is Close, not Primary: every caller of this dialog is confirming something that
        cannot be taken back from the screen afterwards, and Enter should never be the gesture that
        does that. Saying so once here is simpler than trusting every future caller to remember it.
    -->
    <StackPanel Spacing="12" MinWidth="380">
        <TextBlock
            x:Name="BodyText"
            TextWrapping="Wrap"
            Foreground="{ThemeResource NobaTextPrimary}" />
    </StackPanel>
</ContentDialog>
