<Project>

  <!--
    Shared build settings for every project in the NOBA Archive solution.

    NobaOfflineBuild=true swaps the Microsoft.Extensions.* NuGet packages for the
    Microsoft.AspNetCore.App shared framework (which contains the same assemblies) and
    swaps xUnit v3 for the dependency-free harness in NOBA.Archive.TestKit. It exists so the
    solution can be built and tested in an environment with no access to nuget.org.
    The shipping configuration is the default (NobaOfflineBuild unset/false).
  -->
  <PropertyGroup>
    <NobaOfflineBuild Condition="'$(NobaOfflineBuild)' == '' AND '$(NOBA_OFFLINE_BUILD)' == '1'">true</NobaOfflineBuild>
    <NobaOfflineBuild Condition="'$(NobaOfflineBuild)' == ''">false</NobaOfflineBuild>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);CA1848;CA1031;CA2007</NoWarn>
    <Product>NOBA Archive</Product>
    <Company>NOBA</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
